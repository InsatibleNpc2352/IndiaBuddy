# =============================================================================
# IndiaBuddy — Environment Configuration
# Copy this file to .env and fill in your values before running docker-compose
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://indiabuddy:postgres@db:5432/indiabuddy
POSTGRES_USER=indiabuddy
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=indiabuddy

# --- Redis ---
REDIS_URL=redis://:redis@redis:6379/0
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# --- JWT Auth (generate with: openssl rand -hex 32) ---
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- News API (free key at https://newsapi.org/register) ---
NEWSAPI_KEY=7bd7aa14e1d547eca40cdf3efb25d74d

# --- Ghost Browser ---
GHOST_BROWSER_URL=http://ghost-browser:8001
MAX_GHOST_BROWSER_POOL_SIZE=3

# --- Proxy (optional, comma-separated residential proxies for heavy sites) ---
# Format: http://user:pass@host:port,http://user:pass@host:port
PROXY_LIST=

# --- CORS (comma-separated, use your actual domain) ---
CORS_ORIGINS=["https://indiabuddy.in","http://localhost:3000"]

# --- App Settings ---
ENVIRONMENT=production
DAILY_REPORT_HOUR=6
RATE_LIMIT_PER_MINUTE=60

# --- Frontend ---
NEXT_PUBLIC_API_URL=/api
